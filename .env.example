# Copy to .env and fill in. NEVER commit .env.
# Generate secrets with:  docker compose run --rm api unjobless gen-key   (or: cd backend && uv run unjobless gen-key)

UNJOBLESS_ENV=production
UNJOBLESS_LOG_LEVEL=INFO

# Public hostname served by Caddy (use "localhost" for a local test).
UNJOBLESS_DOMAIN=localhost
UNJOBLESS_PUBLIC_BASE_URL=https://localhost
UNJOBLESS_CORS_ORIGINS=["https://localhost"]

# Required secrets (>= 32 bytes, urlsafe base64). Back up UNJOBLESS_MASTER_KEY separately:
# without it, stored AI provider keys cannot be decrypted after a restore.
UNJOBLESS_MASTER_KEY=
UNJOBLESS_SESSION_SECRET=

# PostgreSQL
POSTGRES_DB=unjobless
POSTGRES_USER=unjobless
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://unjobless:${POSTGRES_PASSWORD}@db:5432/unjobless

# Honest crawler identification
UNJOBLESS_USER_AGENT=UnjoblessBot/0.1 (+personal self-hosted career research; respects robots.txt)

# Limits
UNJOBLESS_MAX_URLS_PER_BATCH=50
UNJOBLESS_FETCH_MAX_BYTES=5242880
UNJOBLESS_MAX_UPLOAD_BYTES=10485760
UNJOBLESS_GLOBAL_WORKER_CONCURRENCY=4
