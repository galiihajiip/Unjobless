# Automatic HTTPS: Caddy obtains and renews certificates for UNJOBLESS_DOMAIN (ACME, no email required).
# For "localhost" it uses its own local CA.

{$UNJOBLESS_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	# The browser clipper page is opened by the job site the owner is viewing and receives the page via
	# postMessage, so it must keep its opener. Every other page isolates its browsing context.
	@not_clip not path /import/clip
	header @not_clip Cross-Origin-Opener-Policy "same-origin"

	handle /api/* {
		request_body {
			max_size 12MB
		}
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@nocache path /sw.js /index.html /manifest.webmanifest /registerSW.js
		header @nocache Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format json
	}
}
