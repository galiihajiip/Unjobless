{
  "name": "unjobless",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev:web": "pnpm --filter @unjobless/web dev",
    "build:web": "pnpm --filter @unjobless/web build",
    "lint:web": "pnpm --filter @unjobless/web lint",
    "typecheck:web": "pnpm --filter @unjobless/web typecheck",
    "test:web": "pnpm --filter @unjobless/web test",
    "format": "prettier --write \"apps/web/src/**/*.{ts,tsx,css}\""
  }
}
